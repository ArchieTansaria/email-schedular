{
  "name": "@reachinbox/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "pretest": "pnpm --filter @reachinbox/shared build",
    "pretest:run": "pnpm --filter @reachinbox/shared build"
  },
  "dependencies": {
    "@reachinbox/shared": "workspace:*",
    "dotenv": "17.2.1",
    "pino": "9.9.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "tsx": "4.20.5",
    "vitest": "3.2.4"
  }
}
