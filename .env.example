# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# Persistence and execution
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_test
REDIS_URL=redis://localhost:6379

# Search (API key is normally empty only for local Docker Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# Application secrets: use independent high-entropy production values
SESSION_SECRET=local-development-session-secret-change-me
APP_ENCRYPTION_KEY=local-development-encryption-key-change-me

# Google OAuth
# Required by the API. The callback must exactly match the Google Web OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Slack OAuth (optional, but configure all three values together)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/v1/integrations/slack/callback

# Ethereal SMTP and provisioned Sender identities
# Both usernames are required by the API for automatic Sender provisioning.
# Both username/password pairs are required by the Worker for SMTP delivery.
ETHEREAL_SENDER_1_USER=
ETHEREAL_SENDER_1_PASS=
ETHEREAL_SENDER_2_USER=
ETHEREAL_SENDER_2_PASS=

# Worker and platform safety limits
WORKER_CONCURRENCY=10
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
