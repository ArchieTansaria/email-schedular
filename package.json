{
  "name": "reachinbox-scheduler",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": ">=10.15.1 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "build:shared": "pnpm --filter @reachinbox/shared build",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm build:shared && concurrently -k -n api,worker,web -c blue,magenta,green \"pnpm --filter @reachinbox/api dev\" \"pnpm --filter @reachinbox/worker dev\" \"pnpm --filter @reachinbox/web dev\"",
    "dev:api": "pnpm build:shared && pnpm --filter @reachinbox/api dev",
    "dev:worker": "pnpm build:shared && pnpm --filter @reachinbox/worker dev",
    "dev:web": "pnpm build:shared && pnpm --filter @reachinbox/web dev",
    "start:api": "pnpm --filter @reachinbox/api start",
    "start:worker": "pnpm --filter @reachinbox/worker start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm build:shared && pnpm -r --if-present typecheck && pnpm typecheck:db",
    "typecheck:db": "tsc -p prisma/tsconfig.json --noEmit",
    "test": "pnpm build:shared && vitest",
    "test:run": "pnpm build:shared && vitest run",
    "test:coverage": "pnpm build:shared && vitest run --coverage",
    "pretest": "pnpm db:test:migrate",
    "pretest:run": "pnpm db:test:migrate",
    "pretest:coverage": "pnpm db:test:migrate",
    "test:db": "vitest run --config prisma/vitest.config.ts",
    "test:queue": "pnpm build:shared && pnpm --filter @reachinbox/api test:queue",
    "test:scheduling": "pnpm build:shared && pnpm --filter @reachinbox/api test:scheduling && vitest run --config prisma/vitest.config.ts tests/scheduling.integration.test.ts",
    "test:worker": "pnpm build:shared && pnpm --filter @reachinbox/worker test:run",
    "verify:ethereal": "pnpm build:shared && pnpm --filter @reachinbox/worker verify:ethereal",
    "pretest:db": "pnpm db:test:migrate",
    "pretest:scheduling": "pnpm db:test:migrate",
    "pretest:worker": "pnpm db:test:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:test:migrate": "node scripts/with-test-database.mjs migrate deploy"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@prisma/client": "6.15.0",
    "@types/node": "22.15.30",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "9.2.1",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "prisma": "6.15.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
