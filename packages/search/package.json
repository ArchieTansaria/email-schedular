{
  "name": "@reachinbox/search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "search:init": "tsx src/init-search.ts",
    "search:reindex": "tsx src/reindex-search.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "8.19.0",
    "@prisma/client": "6.15.0",
    "dotenv": "17.2.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "tsx": "4.20.5",
    "vitest": "3.2.4"
  }
}
