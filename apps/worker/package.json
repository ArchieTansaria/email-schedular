{
  "name": "@reachinbox/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "reconcile:queue": "tsx src/reconcile-queue.ts",
    "verify:ethereal": "tsx src/verify-ethereal.ts",
    "pretest": "pnpm --filter @reachinbox/shared build && pnpm --filter @reachinbox/search build",
    "pretest:run": "pnpm --filter @reachinbox/shared build && pnpm --filter @reachinbox/search build"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "@reachinbox/search": "workspace:*",
    "@reachinbox/shared": "workspace:*",
    "bullmq": "6.3.11",
    "dotenv": "17.2.1",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.13",
    "pino": "9.9.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "tsx": "4.20.5",
    "vitest": "3.2.4"
  }
}
