{
  "name": "@reachinbox/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./attachments": {
      "types": "./src/attachments.ts",
      "import": "./dist/attachments.js"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./dist/env.js"
    },
    "./queue": {
      "types": "./src/queue.ts",
      "import": "./dist/queue.js"
    },
    "./leads": {
      "types": "./src/leads.ts",
      "import": "./dist/leads.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "zod": "4.1.5"
  },
  "devDependencies": {
    "vitest": "3.2.4"
  }
}
