{
  "name": "@reachinbox/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:queue": "vitest run src/queue src/bull-board.integration.test.ts",
    "test:scheduling": "vitest run src/modules/campaigns",
    "pretest": "pnpm --filter @reachinbox/shared build && pnpm --filter @reachinbox/search build && pnpm --filter @reachinbox/slack build",
    "pretest:run": "pnpm --filter @reachinbox/shared build && pnpm --filter @reachinbox/search build && pnpm --filter @reachinbox/slack build"
  },
  "dependencies": {
    "@bull-board/api": "9.10.2",
    "@bull-board/express": "9.10.2",
    "@prisma/client": "6.15.0",
    "@reachinbox/search": "workspace:*",
    "@reachinbox/shared": "workspace:*",
    "@reachinbox/slack": "workspace:*",
    "bullmq": "6.3.11",
    "connect-redis": "10.0.0",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "express-session": "1.19.0",
    "google-auth-library": "11.1.0",
    "ioredis": "6.0.0",
    "multer": "2.4.0",
    "pino": "9.9.0",
    "redis": "6.3.0",
    "sanitize-html": "2.18.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "vitest": "3.2.4"
  }
}
